# Cloudflare Pages response headers. Mirrors the "headers" block in vercel.json.
# Cloudflare already sends "max-age=0, must-revalidate" on HTML, so the .html rule is not repeated here.

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/applications/main-site/public/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/core/authentication/client.js
  Cache-Control: no-cache, no-store, must-revalidate

/site-appearance/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS: browsers check for a newer copy on every load (a cheap 304 when unchanged).
# Without this, Cloudflare's 4-hour default keeps old styles after a deploy.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/core/*
  Cache-Control: public, max-age=0, must-revalidate

/applications/*
  Cache-Control: public, max-age=0, must-revalidate

/site-appearance/css-styles/*
  Cache-Control: public, max-age=0, must-revalidate

/site-appearance/js-runtime/*
  Cache-Control: public, max-age=0, must-revalidate
