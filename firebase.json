{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "applications/archive/**",
      "core/server/**",
      "site-appearance/documentation/**",
      "core/tests/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          }
        ]
      },
      {
        "source": "/core/authentication/client.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/", "destination": "/applications/main-site/pages/index.html" },
      { "source": "/index.html", "destination": "/applications/main-site/pages/index.html" },
      { "source": "/login.html", "destination": "/applications/main-site/pages/login.html" },
      { "source": "/signup.html", "destination": "/applications/main-site/pages/signup.html" },
      { "source": "/settings.html", "destination": "/applications/main-site/pages/settings.html" },
      { "source": "/reset-password.html", "destination": "/applications/main-site/pages/reset-password.html" },
      { "source": "/privacy-policy.html", "destination": "/applications/main-site/pages/privacy-policy.html" },
      { "source": "/terms-of-service.html", "destination": "/applications/main-site/pages/terms-of-service.html" },
      { "source": "/sw.js", "destination": "/applications/main-site/public/sw.js" },
      { "source": "/manifest.webmanifest", "destination": "/applications/main-site/public/manifest.webmanifest" },
      { "source": "/robots.txt", "destination": "/applications/main-site/public/robots.txt" },
      { "source": "/Alysum-3.png", "destination": "/applications/main-site/public/Alysum-3.png" },
      { "source": "/js/pwa-register.js", "destination": "/applications/main-site/page-ui/pwa-register.js" },
      { "source": "/js/vercel-analytics.js", "destination": "/applications/main-site/page-ui/vercel-analytics.js" },
      { "source": "/js/seo-meta.js", "destination": "/applications/main-site/page-ui/seo-meta.js" },
      { "source": "/js/workspace-nav.js", "destination": "/applications/main-site/page-ui/workspace-nav.js" },
      { "source": "/js/homepage-auth-nav.js", "destination": "/applications/main-site/page-ui/homepage-auth-nav.js" },
      { "source": "/js/homepage.js", "destination": "/applications/main-site/page-ui/homepage.js" },
      { "source": "/js/homepage-library.js", "destination": "/applications/main-site/page-ui/homepage-library.js" },
      { "source": "/js/user-backup.js", "destination": "/applications/main-site/page-ui/user-backup.js" },
      { "source": "/js/backup-zip.js", "destination": "/applications/main-site/page-ui/backup-zip.js" },
      { "source": "/js/prompt.js", "destination": "/applications/main-site/page-ui/prompt.js" },
      { "source": "/js/login.js", "destination": "/applications/main-site/page-ui/login.js" },
      { "source": "/js/login-ui.js", "destination": "/applications/main-site/page-ui/login-ui.js" },
      { "source": "/js/login-reset.js", "destination": "/applications/main-site/page-ui/login-reset.js" },
      { "source": "/js/feature-highlights.js", "destination": "/applications/main-site/page-ui/feature-highlights.js" },
      { "source": "/js/settings/page.js", "destination": "/applications/main-site/page-ui/settings/page.js" },
      { "source": "/js/settings/elements.js", "destination": "/applications/main-site/page-ui/settings/elements.js" },
      { "source": "/js/settings/state.js", "destination": "/applications/main-site/page-ui/settings/state.js" },
      { "source": "/js/settings/helpers.js", "destination": "/applications/main-site/page-ui/settings/helpers.js" },
      { "source": "/js/settings/nav.js", "destination": "/applications/main-site/page-ui/settings/nav.js" },
      { "source": "/js/settings/author-page.js", "destination": "/applications/main-site/page-ui/settings/author-page.js" },
      { "source": "/js/settings/appearance.js", "destination": "/applications/main-site/page-ui/settings/appearance.js" },
      { "source": "/js/settings/backup.js", "destination": "/applications/main-site/page-ui/settings/backup.js" },
      { "source": "/js/settings/shell.js", "destination": "/applications/main-site/page-ui/settings/shell.js" },
      { "source": "/js/settings/saves.js", "destination": "/applications/main-site/page-ui/settings/saves.js" },
      { "source": "/css/site-responsive.css", "destination": "/applications/main-site/pages-css/site-responsive.css" },
      { "source": "/css/workspace-nav.css", "destination": "/applications/main-site/pages-css/workspace-nav.css" },
      { "source": "/css/homepage/page.css", "destination": "/applications/main-site/pages-css/homepage/page.css" },
      { "source": "/css/homepage/navigation.css", "destination": "/applications/main-site/pages-css/homepage/navigation.css" },
      { "source": "/css/homepage/hero.css", "destination": "/applications/main-site/pages-css/homepage/hero.css" },
      { "source": "/css/homepage/about.css", "destination": "/applications/main-site/pages-css/homepage/about.css" },
      { "source": "/css/homepage/library.css", "destination": "/applications/main-site/pages-css/homepage/library.css" },
      { "source": "/css/homepage/features.css", "destination": "/applications/main-site/pages-css/homepage/features.css" },
      { "source": "/css/homepage/footer.css", "destination": "/applications/main-site/pages-css/homepage/footer.css" },
      { "source": "/css/homepage/breakpoints.css", "destination": "/applications/main-site/pages-css/homepage/breakpoints.css" },
      { "source": "/css/login/page.css", "destination": "/applications/main-site/pages-css/login/page.css" },
      { "source": "/css/login/messages.css", "destination": "/applications/main-site/pages-css/login/messages.css" },
      { "source": "/css/settings/page.css", "destination": "/applications/main-site/pages-css/settings/page.css" },
      { "source": "/css/settings/appearance.css", "destination": "/applications/main-site/pages-css/settings/appearance.css" },
      { "source": "/css/settings/account.css", "destination": "/applications/main-site/pages-css/settings/account.css" },
      { "source": "/css/settings/profile.css", "destination": "/applications/main-site/pages-css/settings/profile.css" },
      { "source": "/css/settings/backup.css", "destination": "/applications/main-site/pages-css/settings/backup.css" }
    ]
  }
}
