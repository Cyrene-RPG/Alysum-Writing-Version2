rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // --- User profile & private subcollections ---
    match /users/{userId} {
      allow read: if true;
      allow create: if isUser(userId);
      allow update, delete: if isUser(userId);

      match /books/{bookId} {
        allow read, write: if isUser(userId);

        // Story Bible — character sheets for this book (same owner as the book doc).
        match /bibleCharacters/{characterId} {
          allow read, write: if isUser(userId);
        }

        match /biblePlaces/{placeId} {
          allow read, write: if isUser(userId);
        }
      }

      match /promptEntries/{entryId} {
        allow read, write: if isUser(userId);
      }

      match /notebookVault/{docId} {
        allow read, write: if isUser(userId);
      }

      // Reader-only index: which beta notes this user has already shared with authors (dedupe + UI).
      match /betaSharesIndex/{shareId} {
        allow read, write: if isUser(userId);
      }

      // Author inbox: beta readers can create notifications only for the real library owner of that book.
      match /notifications/{notifId} {
        allow read: if isUser(userId);
        allow delete: if isUser(userId);

        allow create: if signedIn()
          && request.resource.data.keys().hasAll([
            'type', 'read', 'readerUid', 'readerName', 'authorUid', 'bookId',
            'bookTitle', 'noteId', 'quote', 'comment', 'chapterTitle', 'shareKey'
          ])
          && request.resource.data.type == 'beta_note_shared'
          && request.resource.data.read == false
          && request.resource.data.readerUid == request.auth.uid
          && request.resource.data.authorUid == userId
          && userId == get(/databases/$(database)/documents/library/$(request.resource.data.bookId)).data.ownerUid
          && request.auth.uid != userId
          && request.resource.data.bookId is string
          && request.resource.data.noteId is string
          && request.resource.data.shareKey is string
          && request.resource.data.readerName is string
          && request.resource.data.bookTitle is string
          && request.resource.data.chapterTitle is string
          && request.resource.data.quote is string
          && request.resource.data.quote.size() < 2200
          && request.resource.data.comment is string
          && request.resource.data.comment.size() < 8200
          // Same-batch pair: exists() only sees committed docs; getAfter() sees this atomic batch.
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/betaSharesIndex/$(request.resource.data.shareKey)).data.authorUid == request.resource.data.authorUid
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/betaSharesIndex/$(request.resource.data.shareKey)).data.bookId == request.resource.data.bookId
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/betaSharesIndex/$(request.resource.data.shareKey)).data.noteId == request.resource.data.noteId;

        allow update: if isUser(userId)
          && resource.data.authorUid == userId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      }
    }

    // --- Published library listing & engagement ---
    match /library/{bookId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      // Owner can update any fields on their listing.
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      // Readers can only adjust aggregate counters; owner uid must stay the same.
      allow update: if signedIn()
        && resource.data.ownerUid == request.resource.data.ownerUid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['views', 'likes']);

      match /reads/{readId} {
        allow read: if true;
        // Anonymous view tracking (read.html) + optional signed uid on the row.
        allow create: if request.resource.data.keys().hasAll(['readerId', 'createdAt'])
          && request.resource.data.readerId is string
          && (
            request.auth == null
              ? (!('uid' in request.resource.data) || request.resource.data.uid == null)
              : (!('uid' in request.resource.data)
                || request.resource.data.uid == null
                || request.resource.data.uid == request.auth.uid)
          );
      }

      match /likes/{likerId} {
        allow read: if true;
        allow create: if signedIn()
          && likerId == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && likerId == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }
    }
  }
}
