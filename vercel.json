      "destination": "/applications/main-site/pages/reset-password.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/applications/main-site/pages/privacy-policy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/applications/main-site/pages/terms-of-service.html"
    },
    {
      "source": "/statistics-spec",
      "destination": "/applications/main-site/pages/statistics-spec.html"
