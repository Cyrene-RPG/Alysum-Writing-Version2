    {
      "source": "/css/library/:path*",
      "destination": "/applications/library/library-css/:path*"
    },
    {
      "source": "/css/statistics-ui/:path*",
      "destination": "/applications/main-site/statistics-ui/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/applications/main-site/pages-css/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/applications/main-site/assets/:path*"
