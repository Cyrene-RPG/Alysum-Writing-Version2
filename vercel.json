{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/",
      "destination": "/applications/main-site/pages/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/applications/main-site/pages/index.html"
    },
    {
      "source": "/sw.js",
      "destination": "/applications/main-site/public/sw.js"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/applications/main-site/public/manifest.webmanifest"
    },
    {
      "source": "/robots.txt",
      "destination": "/applications/main-site/public/robots.txt"
    },
    {
      "source": "/Alysum-3.png",
      "destination": "/applications/main-site/public/Alysum-3.png"
    },
    {
      "source": "/discord-logo.png",
      "destination": "/applications/main-site/public/discord-logo.png"
    },
    {
      "source": "/js/homepage.js",
      "destination": "/applications/main-site/homepage/homepage.js"
    },
    {
      "source": "/js/homepage-library.js",
      "destination": "/applications/main-site/homepage/homepage-library.js"
    },
    {
      "source": "/js/homepage-auth-nav.js",
      "destination": "/applications/main-site/homepage/homepage-auth-nav.js"
    },
    {
      "source": "/js/login.js",
      "destination": "/applications/main-site/login/login.js"
    },
    {
      "source": "/js/login-ui.js",
      "destination": "/applications/main-site/login/login-ui.js"
    },
    {
      "source": "/js/login-reset.js",
      "destination": "/applications/main-site/login/login-reset.js"
    },
    {
      "source": "/js/signup/:path*",
      "destination": "/applications/main-site/signup/:path*"
    },
    {
      "source": "/js/settings/:path*",
      "destination": "/applications/main-site/settings/:path*"
    },
    {
      "source": "/js/studio/:path*",
      "destination": "/applications/studio/page-ui/:path*"
    },
    {
      "source": "/js/editor/:path*",
      "destination": "/applications/editor/page-ui/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/applications/main-site/page-ui/:path*"
    },
    {
      "source": "/css/homepage/:path*",
      "destination": "/applications/main-site/homepage/homepage-css/:path*"
    },
    {
      "source": "/css/login/:path*",
      "destination": "/applications/main-site/login/login-css/:path*"
    },
    {
      "source": "/css/signup/:path*",
      "destination": "/applications/main-site/signup/signup-css/:path*"
    },
    {
      "source": "/css/settings/:path*",
      "destination": "/applications/main-site/settings/settings-css/:path*"
    },
    {
      "source": "/css/studio/:path*",
      "destination": "/applications/studio/studio-css/:path*"
    },
    {
      "source": "/css/editor/:path*",
      "destination": "/applications/editor/editor-css/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/applications/main-site/pages-css/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/applications/main-site/assets/:path*"
    },
    {
      "source": "/studio.html",
      "destination": "/applications/studio/pages/studio.html"
    },
    {
      "source": "/editor.html",
      "destination": "/applications/editor/pages/editor.html"
    },
    {
      "source": "/:page.html",
      "destination": "/applications/main-site/pages/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/core/authentication/client.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/site-appearance/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
