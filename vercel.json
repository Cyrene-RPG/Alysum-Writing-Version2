      "destination": "/applications/word-wars/pages/word-wars.html"
    },
    {
      "source": "/library",
      "destination": "/applications/library/pages/library.html"
    },
    {
      "source": "/book",
      "destination": "/applications/library/pages/book.html"
    },
    {
      "source": "/read",
      "destination": "/applications/library/pages/read.html"
    },
    {
      "source": "/publish",
      "destination": "/applications/studio/pages/publish.html"
    },
    {
      "source": "/login",
      "destination": "/applications/main-site/pages/login.html"
    },
    {
      "source": "/signup",
      "destination": "/applications/main-site/pages/signup.html"
    },
    {
      "source": "/settings",
      "destination": "/applications/main-site/pages/settings.html"
    },
    {
      "source": "/overview",
      "destination": "/applications/main-site/pages/overview.html"
    },
    {
