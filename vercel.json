{
  "rewrites": [
    { "source": "/Story-Bible-New.html", "destination": "/story-bible.html" },
    { "source": "/story-bible-new.html", "destination": "/story-bible.html" },
    { "source": "/story-bible-legacy.html", "destination": "/story-bible.html" }
  ],
  "headers": [
    {
      "source": "/firebase.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
